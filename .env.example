# URL Laravel API (tanpa garis miring di akhir)
VITE_API_URL=http://localhost:8000

# URL publik website, dipakai untuk canonical, Open Graph, dan sitemap
VITE_SITE_URL=http://localhost:5173

# Kunci Web3Forms untuk form tiket/kontak (gratis di https://web3forms.com).
# Jika diisi, pesan langsung dikirim ke email kamu tanpa backend.
# Jika kosong, form memakai Laravel API di VITE_API_URL.
VITE_WEB3FORMS_KEY=
